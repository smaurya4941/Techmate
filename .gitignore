# Root .gitignore for Techmate Industries Monorepo

# Environment and sensitive local files
.env
.env.local
.env.*.local
backend/.env
frontend/.env.local
!*.env.example
!**/.env.example

# Dependencies
node_modules/
backend/vendor/
frontend/node_modules/

# Next.js Build Output
frontend/.next/
frontend/out/
frontend/build/
.next/
out/
build/

# Laravel Storage and Logs
backend/storage/*.key
backend/storage/framework/cache/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/framework/testing/*
backend/storage/logs/*.log
backend/bootstrap/cache/*.php
backend/database/*.sqlite
backend/database/*.sqlite-journal

# Testing and Coverage
.phpunit.cache/
backend/.phpunit.cache/
coverage/
*.lcov

# IDE and Operating System Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
Desktop.ini

# Logs and Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local Scratch / Temporary
scratch/
tmp/
*.tmp
